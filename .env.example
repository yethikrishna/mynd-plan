# ---- Agent (required to enable the AI) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Auth (NextAuth) ----
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional GitHub OAuth (email sign-in works without these)
GITHUB_ID=
GITHUB_SECRET=

# ---- Database (optional \u2014 app runs without it) ----
# Free serverless Postgres: https://neon.tech
DATABASE_URL=
